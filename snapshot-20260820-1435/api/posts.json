d9 \u05d4\u05e9\u05de\u05e9, \u05dc\u05d7\u05d5\u05ea \u05d5\u05d0\u05d1\u05e7 \u2013 \u05ea\u05e0\u05d0\u05d9 \u05d0\u05e7\u05dc\u05d9\u05dd \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc. \u05d4\u05d7\u05d5\u05de\u05e8 \u05de\u05d0\u05e4\u05e9\u05e8 \u05de\u05e8\u05d0\u05d4 \u05e2\u05e5, \u05d1\u05d8\u05d5\u05df \u05d0\u05d5 \u05d2\u05d5\u05d5\u05e0\u05d9\u05dd \u05d0\u05d7\u05d9\u05d3\u05d9\u05dd \u05d1\u05dc\u05d9 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d8\u05d1\u05e2\u05d9\u05d9\u05dd.\n      <\/p>\n<p style=\"margin-bottom: 1.5rem\">\n        \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d7\u05e9\u05d5\u05d1 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05dc\u05d5\u05d7\u05d5\u05ea \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05d9\u05dd \u05dc\u05d7\u05d6\u05d9\u05ea\u05d5\u05ea \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05e2\u05dd \u05d4\u05d2\u05e0\u05ea UV. \u05d4\u05ea\u05e7\u05e0\u05d4 \u05e0\u05db\u05d5\u05e0\u05d4 \u05e2\u05dd \u05de\u05e8\u05d5\u05d5\u05d7\u05d9 \u05d4\u05ea\u05e4\u05e9\u05d8\u05d5\u05ea \u05de\u05d1\u05d8\u05d9\u05d7\u05d4 \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df.\n      <\/p>\n<h3 style=\"color: #fff;margin-top: 2rem;margin-bottom: 1rem\">\u05d9\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd:<\/h3>\n<ul style=\"padding-right: 1.5rem;margin-bottom: 1.5rem\">\n<li>\u2714 <strong>\u05e2\u05de\u05d9\u05d3\u05d5\u05ea UV \u05d2\u05d1\u05d5\u05d4\u05d4:<\/strong> \u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d2\u05d5\u05d5\u05df \u05d5\u05d3\u05d4\u05d9\u05d9\u05d4 \u05ea\u05d7\u05ea \u05e7\u05e8\u05d9\u05e0\u05ea \u05e9\u05de\u05e9 \u05d9\u05e9\u05d9\u05e8\u05d4.<\/li>\n<li>\u2714 <strong>\u05de\u05d2\u05d5\u05d5\u05df \u05d8\u05e7\u05e1\u05d8\u05d5\u05e8\u05d5\u05ea:<\/strong> \u05de\u05d2\u05d5\u05d5\u05df \u05d8\u05e7\u05e1\u05d8\u05d5\u05e8\u05d5\u05ea \u05e2\u05e5 \u05d8\u05d1\u05e2\u05d9, \u05d1\u05d8\u05d5\u05df \u05de\u05d5\u05d7\u05dc\u05e7 \u05d5\u05d2\u05d5\u05d5\u05e0\u05d9 RAL.<\/li>\n<li>\u2714 <strong>\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05e4\u05e9\u05d5\u05d8\u05d4:<\/strong> \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e7\u05dc \u05de\u05e2\u05e4\u05e8 \u05d5\u05d2\u05e8\u05e4\u05d9\u05d8\u05d9 \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05e6\u05d1\u05d9\u05e2\u05d4 \u05de\u05d7\u05d5\u05d3\u05e9\u05ea.<\/li>\n<\/ul>\n<div style=\"margin-top: 3rem;background: var(--card-bg, #1a1a1a);padding: 2rem;border-radius: 12px;border: 1px solid #333\">\n<h4 style=\"color: #fff;margin-bottom: 0.5rem\">\u05e8\u05d5\u05e6\u05d9\u05dd \u05dc\u05e9\u05dc\u05d1 \u05d7\u05d9\u05e4\u05d5\u05d9 HPL \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e9\u05dc\u05db\u05dd?<\/h4>\n<p style=\"margin-bottom: 1rem\">\u05e6\u05e8\u05d5 \u05e7\u05e9\u05e8 \u05e2\u05dd \u05de\u05d5\u05de\u05d7\u05d9 Alu-on \u05dc\u05e7\u05d1\u05dc\u05ea \u05d9\u05d9\u05e2\u05d5\u05e5 \u05d8\u05db\u05e0\u05d9 \u05d5\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d2\u05d5\u05d5\u05e0\u05d9\u05dd \u05de\u05e8\u05d5\u05d7\u05d1.<\/p>\n<p>        <a href=\"https:\/\/wa.me\/972509997753?text=\u05e9\u05dc\u05d5\u05dd, \u05e7\u05e8\u05d0\u05ea\u05d9 \u05d0\u05ea \u05d4\u05de\u05d0\u05de\u05e8 \u05d1\u05e0\u05d5\u05e9\u05d0 HPL \u05d5\u05d0\u05e9\u05de\u05d7 \u05dc\u05e7\u05d1\u05dc \u05e7\u05d8\u05dc\u05d5\u05d2 \u05d5\u05d9\u05d9\u05e2\u05d5\u05e5\" target=\"_blank\" class=\"btn-pill btn-white\">\u05e6\u05e8\u05d5 \u05e7\u05e9\u05e8 \u05d1-WhatsApp<\/a>\n      <\/div>\n<\/p><\/div>\n<\/section>\n<footer>\n<div class=\"container\" style=\"display:flex;justify-content:space-between;align-items:center\">\n      <a href=\"..\/index.html\" class=\"logo-brand\"><span class=\"logo-title\">Alu-on<\/span> <s